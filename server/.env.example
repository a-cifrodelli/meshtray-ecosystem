# ===================================================================
# MESHTRAY ECOSYSTEM - Configurazione di Ambiente Server (.env)
# ===================================================================
# Copia questo file in '.env' nella root del progetto o nella cartella server:
# cp server/.env.example .env

# --- Configurazione Broker MQTT (OBBLIGATORIO) ---
MQTT_BROKER=mqtt.example.com
MQTT_PORT=8883
MQTT_USER=tuo_username_mqtt
MQTT_PASS=tua_password_mqtt

# --- Configurazione Dispositivo Meshtastic (Seriale) ---
# Esempi Linux: /dev/ttyUSB0, /dev/ttyACM0
# Esempi Windows: COM3, COM4
SERIAL_PORT=/dev/ttyUSB0

# --- Configurazione Database (Opzionale) ---
# Percorso personalizzato per il database SQLite (di default: data/meshtastic.db)
# DATABASE_PATH=/var/lib/meshtray/meshtastic.db

# --- Certificati TLS MQTT (Opzionale) ---
# MQTT_CA_CERTS=/path/to/root_ca.crt
