# ==================================================
# Meshtray Ecosystem - Server Template .env
# Copia questo file in 'server/.env' e configura
# ==================================================

# Broker MQTT a cui collegarsi per ricevere i messaggi Meshtastic (JSON feed)
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883

# Credenziali di accesso per il broker (lascia vuote se non necessarie)
MQTT_USER=
MQTT_PASS=

# ID client MQTT univoco per il server translator
MQTT_CLIENT_ID=meshtray_ecosystem_server

# URL di connessione SQLAlchemy per il database SQLite locale (Driver asincrono aiosqlite)
DATABASE_URL=sqlite+aiosqlite:///./data/messages.db

# Porta seriale fisica del dispositivo radio USB Meshtastic per trasmettere in LoRa
# Esempio su Windows: COM3 | Esempio su Linux: /dev/ttyUSB0
# Rimuovi o commenta la riga per disattivare la trasmissione seriale hardware (default: /dev/ttyUSB0)
# SERIAL_PORT=/dev/ttyUSB0

# Configurazione di rete del server WebSocket / API FastAPI
HOST=0.0.0.0
PORT=8088
